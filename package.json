{
  "name": "parquet-x",
  "displayName": "Parquet-X",
  "description": "View, query, create, compare, diagnose, and export Apache Parquet files in VS Code.",
  "version": "1.1.4",
  "publisher": "CosmicTechnoid",
  "icon": "media/icons/logo.png",
  "license": "MIT",
  "author": {
    "name": "Akshara A",
    "email": "akshararajan26@outlook.in"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akshara-a/Parquet-X.git"
  },
  "bugs": {
    "url": "https://github.com/akshara-a/Parquet-X/issues"
  },
  "homepage": "https://github.com/akshara-a/Parquet-X#readme",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "Apache Parquet",
    "Data",
    "Parquet Viewer",
    "Data Visualization",
    "DuckDB",
    "uv",
    "Parquet"
  ],
  "activationEvents": [
    "onCommand:parquetViewer.setupEnvironment",
    "onCommand:parquetViewer.showLogs",
    "onCommand:parquetViewer.resetEnvironment",
    "onCommand:parquetViewer.environmentDoctor",
    "onCustomEditor:parquetViewer.parquetViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "parquetViewer.parquetViewer",
        "displayName": "Parquet Viewer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "parquetViewer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "parquetViewer.setupEnvironment",
        "title": "Setup Python Environment",
        "category": "Parquet Viewer"
      },
      {
        "command": "parquetViewer.showLogs",
        "title": "Show Parquet Viewer Logs",
        "category": "Parquet Viewer"
      },
      {
        "command": "parquetViewer.resetEnvironment",
        "title": "Reset Python Environment",
        "category": "Parquet Viewer"
      },
      {
        "command": "parquetViewer.environmentDoctor",
        "title": "Show Environment Doctor",
        "category": "Parquet Viewer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run copy-files",
    "compile": "tsc -p ./",
    "copy-files": "copyfiles -u 1 src/*.py out/",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.8",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3"
  }
}
